(import "TruthTable.json")

(start 0)

(# 所有变量必须在指令构建（inst）外部统一声明)

(# 内存变量；哈佛架构)
(mem
	(# 程序源码存放内存：32 行 × 32 字节 = 1024 字节，按字节编址，一条指令占 9 字节
	)
	program 1024 8
	(# 程序运行时产生内存：256 字 × 32 位 = 1024 字节（变量按 32 位字对齐）
	)
	runtime 256 32
)

(# 存储体接口绑定：名字 + 地址线 + 写数据线 + 写使能线 + 读数据线
   （端口名一律以 bind 为准，编译器会校验是否声明为 wire 以及宽度）
)
(bind program program_addr program_din program_we program_dout)
(bind runtime runtime_addr runtime_din runtime_we runtime_dout)

(# 寄存器变量：每个时钟沿更新)
(reg 
	(# 指令寄存器：指令字节的高 6 位，最多 64 条指令
	)
	inst:6 0
	(# 操作数1寄存器)
	op1:32 0
	(# 操作数2寄存器)
	op2:32 0
	(# 复用运算寄存器)
	calcResu:32 0
	(# 程序计数器：程序内存的字节地址（10 位 = 1024 字节），一条指令占 9 字节
	)
	pc:10 0
	(# 取指字节暂存：程序内存每拍读回一个字节，逐拍装进下面 9 个字节寄存器
	)
	instByte:8 0
	op1B0:8 0
	op1B1:8 0
	op1B2:8 0
	op1B3:8 0
	op2B0:8 0
	op2B1:8 0
	op2B2:8 0
	op2B3:8 0
	(# 第一操作数地址取值的暂存：运行内存只有一个读端口，第 10 拍先把 op1Val 收在这里，
	   第 11 拍才能和 op2、inst 同拍装填
	)
	r1:32 0
	(# 前端节拍计数器：0..8 逐字节取指、9 送 op1 地址、10 收 op1Val 并送 op2 地址、
	   11 同拍装填、12 发启动脉冲、13 等多拍单元忙完、14 回写；数到 14 之后回 0
	)
	stateCount:4 0
	(# 停机标志：HLT 置位后前端停在第 0 拍，RESUME 或外部 resume_pin 清掉
	)
	halted:1 0
	(# MUL 状态寄存器)
	acc:32 0
	a_reg:32 0
	b_reg:32 0
	(# 乘法循环计数器；32 拍只需 5 位)
	cnt:5 0
	(# 乘法忙标志)
	busy:1 0
	(# DIV 状态寄存器)
	div_dd:32 0
	div_dvs:32 0
	div_rem:32 0
	div_quo:32 0
	(# 除法循环计数器)
	div_cnt:5 0
	(# 除法忙标志)
	div_busy:1 0
)

(# 组合线变量：实时更新，不按时钟沿延迟)
(wire
	(# 条件指示wire；x位拉起表示发生了情况x（目前 EQ 只用 0/1 两位）
	)
	allCases:2 0
	load:32 0
	(# ADD 加法器：部分和、两级进位、进位链与和；进位链 [0] 恒为 0)
	add_ps:32 0
	add_c1:33 0
	add_c2:33 0
	add_carry:33 0
	add_sum:32 0
	(# SUB 减法器：与 ADD 同构，借位链 [0] 恒为 0)
	sub_ps:32 0
	sub_c1:33 0
	sub_c2:33 0
	sub_borrow:33 0
	sub_diff:32 0
	(# 结果暂存：mux 选出后由 updateResu 写回 calcResu)
	calcResuTmp:32 0
	(# ==== 前端：程序内存接口（1024 字节，地址 10 位）====
	)
	program_addr:10 0
	program_din:8 0
	program_we:1 0
	(# ==== 前端：运行内存接口（256 字 × 32 位 = 1024 字节，地址 8 位）====
	)
	runtime_addr:8 0
	runtime_din:32 0
	runtime_we:1 0
	(# 存储体读数据：由存储体 model 驱动，读出打一拍
	)
	program_dout:8 0
	runtime_dout:32 0
	(# 取指暂存：inst 字节、拼好的 op1/op2，以及按地址可能取回的两个值
	)
	instWire:8 0
	op1Wire:32 0
	op2Wire:32 0
	op1Val:32 0
	op2Val:32 0
	(# 取指字节的下一状态
	)
	instn:8 0
	op1n0:8 0
	op1n1:8 0
	op1n2:8 0
	op1n3:8 0
	op2n0:8 0
	op2n1:8 0
	op2n2:8 0
	op2n3:8 0
	(# 指令字节：高 6 位操作码，末两位是参数 1/2 的地址/立即数标志
	)
	inst_opcode:6 0
	f1:1 0
	f2:1 0
	(# 运行内存地址解析：参数本身就是 4 字节变量地址，变量按 32 位对齐，
	   所以取参数第 2..9 位当 256 字的字地址（低 2 位是字内字节偏移）
	)
	op1_addr:8 0
	op2_addr:8 0
	push_addr:8 0
	(# 装填拍选出的操作数
	)
	op1_ld:32 0
	op2_ld:32 0
	(# 节拍计数器与其相位判据：0..8 取指、9 送 op1 地址、10 收 op1Val 并送 op2 地址、
	   11 同拍装填、12 发启动脉冲、13 等多拍单元忙完、14 回写
	)
	sc_inc:4 0
	sc_carry:5 0
	sc_wrap:4 0
	sc_next:4 0
	zero4:4 0
	hit14:1 0
	h14a:1 0
	h14b:1 0
	n_b0:1 0
	ph12sel:1 0
	ph13sel:1 0
	ph14sel:1 0
	unit_busy:1 0
	stall:1 0
	not_stall:1 0
	instDone:1 0
	doneEn:1 0
	write_en:1 0
	(# pc：逐字节取指期间每拍加 1（先跳再说），一条指令正好 +9
	)
	fetching:1 0
	pc_sum:10 0
	pc_carry:11 0
	pc_next:10 0
	(# 各寄存器下一状态
	)
	inst_next:6 0
	op1_next:32 0
	op2_next:32 0
	r1_next:32 0
	(# 多拍指令的启动脉冲、push 选通与常量
	)
	mul_sel:1 0
	div_sel:1 0
	push_sel:1 0
	start_t:1 0
	div_start_t:1 0
	push_en:1 0
	const_one:1 0
	const_zero:1 0
	(# MUL：启动脉冲与循环状态机)
	m_start:1 0
	cnt_carry:6 0
	cnt_next:5 0
	cnt_not:5 0
	cnt_not_acc:6 0
	cnt_hit:1 0
	busy_next:1 0
	(# MUL 一拍选通信号)
	m_not_busy:1 0
	m_not_start:1 0
	m_not_b0:1 0
	m_add_en:1 0
	m_busy_hold:1 0
	m_keep:1 0
	m_load:1 0
	m_idle:1 0
	(# MUL 移位结果；未驱动位保持初值 0，充当补零)
	a_shift:32 0
	b_shift:32 0
	(# MUL 32 位加法器；carry 为进位链，carry[0] 恒为 0)
	m_ps:32 0
	carry:33 0
	m_c1:33 0
	m_c2:33 0
	sum:32 0
	(# MUL 各寄存器下一状态与选通与项)
	acc_next:32 0
	a_next:32 0
	b_next:32 0
	m_acc_add:32 0
	m_acc_hold:32 0
	m_a_load:32 0
	m_a_hold:32 0
	m_a_keep:32 0
	m_b_load:32 0
	m_b_hold:32 0
	m_b_keep:32 0
	(# DIV：启动脉冲与循环状态机)
	div_start:1 0
	div_cnt_carry:6 0
	div_cnt_next:5 0
	div_cnt_not:5 0
	div_cnt_not_acc:6 0
	div_cnt_hit:1 0
	div_busy_next:1 0
	(# DIV 一拍选通信号)
	div_not_busy:1 0
	div_not_start:1 0
	div_load:1 0
	div_idle:1 0
	div_not_load:1 0
	div_take_en:1 0
	div_skip_en:1 0
	(# DIV 余数左移值：最低位由被除数最高位补入)
	div_rem_in:32 0
	(# DIV 32 位减法器；div_borrow[0] 恒为 0，div_borrow[32] 为最终借位)
	div_ps:32 0
	div_borrow:33 0
	div_b1:33 0
	div_b2:33 0
	div_diff:32 0
	(# DIV 试减结论)
	div_take:1 0
	div_not_take:1 0
	(# DIV 各寄存器下一状态与选通与项)
	div_dd_next:32 0
	div_dvs_next:32 0
	div_rem_next:32 0
	div_quo_next:32 0
	div_rem_diff:32 0
	div_rem_skip:32 0
	div_rem_hold:32 0
	div_rem_or:32 0
	div_dd_shift:32 0
	div_dd_load:32 0
	div_dd_hold:32 0
	div_dd_or:32 0
	div_quo_shift:32 0
	div_quo_hold:32 0
	div_dvs_load:32 0
	div_dvs_hold:32 0
	(# EQ：逐位相等/不等标志与差异或链)
	eqBit:32 0
	neBit:32 0
	neAcc:33 0
	(# EQ 结论：写入 allCases，并落到 eqRes 供 mux 取用)
	eqAny:1 0
	neAny:1 0
	eqRes:1 0
	neRes:1 0
	(# LT：自带减法器的借位链与比较结论)
	lt_ps:32 0
	lt_borrow:33 0
	lt_b1:33 0
	lt_b2:33 0
	lt_diff:32 0
	ltFlag:1 0
	geFlag:1 0
	isTrue:1 0
	jmp:10 0
	jmp_t:10 0
	(# 跳转与停机的组合线
	)
	nzAcc:33 0
	jmp_req:1 0
	jmpt_req:1 0
	jmp_tgt:10 0
	jmp_en:1 0
	jmp_en_a:1 0
	jmpt_en_a:1 0
	pc_inc:10 0
	pc_sel:10 0
	halt_req:1 0
	resume_req:1 0
	resume_pin:1 0
	halt_set:1 0
	resume_set:1 0
	resume_set_done:1 0
	not_resume_set:1 0
	halt_keep:1 0
	halt_next:1 0
	not_halted:1 0
	fetch_en:1 0
	stall_busy:1 0
)

(# 临时变量：编译期展开用，不编入硬件；add/sub/eq/lt 等函数也只对临时变量生效)
(temp 
	bitIndex 0
	(# 各展开循环各自独立的下标：节拍计数、程序数据线、pc 进位、字节拼装、
	   运行内存读值、运行内存地址、写数据、push 地址、操作码切分，
	   以及 MUL/DIV 自己的移位与循环下标
	)
	scIndex 0
	cntIndex 0
	hitIndex 0
	srIndex 0
	laneIndex 0
	valIndex 0
	addrIndex 0
	dinIndex 0
	pushIndex 0
	opIdx 0
	jmpIdx 0
)

(inst MUX_TABLE
	(mux (inst) (calcResuTmp)
		(0 add_sum)
		(1 sub_diff)
		(2 acc)
		(3 div_quo)
		(4 eqRes)
		(5 neRes)
		(6 ltFlag)
		(7 geFlag)
		(8 calcResu)(# 此处代表 push 指令，不改变 calcResu 寄存器的值)
		(9 load)
		(10 calcResu)(# 此处代表 jmp)
		(11 calcResu)(# 此处代表 jmp_T 条件真跳转)
		(12 calcResu)(# 此处代表 hlt 停机指令)
		(13 calcResu)(# 此处代表 resume 开机指令)
	)
)

(inst UPDATE_RESU
	(mov 32 calcResu[0] calcResuTmp[0])
)

(inst FETCH
	(# 前端状态机：15 拍一轮（stateCount 从 0 数到 14 再回 0）。第 0..8 拍逐字节取指：每拍读 1 字节、
	   pc 先跳再说（跳 1 字节、4 字节、4 字节），一条指令正好跳过 9 字节；
	   第 9 拍收下 op2 最高字节并送 op1 的运行内存地址；
	   第 10 拍把 op1 的地址取值收进 r1 并送 op2 的运行内存地址；
	   第 11 拍把 inst、op1、op2 同拍装填；第 12 拍给多拍单元发启动脉冲；
	   第 13 拍等它忙完；第 14 拍回写并置 instDone，之后才回第 0 拍取下一次
	)
	(mux (inst) (unit_busy)
		(2 busy)
		(3 div_busy)
	)
	(mapping "and" ph13sel unit_busy stall_busy)
	(mapping "or" stall_busy halted stall)
	(mapping "not" stall not_stall)
	(mapping "and" ph14sel not_stall doneEn)
	(mapping "set" doneEn[0] instDone[0])

	(# 节拍计数：每拍 +1，第 14 拍之后回 0；stall 时保持
	)
	(parallel (lt scIndex 4)
		(mapping "+" stateCount[scIndex] sc_carry[scIndex] sc_inc[scIndex] sc_carry[(add scIndex 1)])
		(mapping "set" 0 zero4[scIndex])
		(var scIndex (add scIndex 1))
	)
	(mapping "set" 1 sc_carry[0])

	(# 数满 14（1110）就把下一拍清零，否则 +1
	)
	(mapping "and" stateCount[1] stateCount[2] h14a)
	(mapping "and" h14a stateCount[3] h14b)
	(mapping "not" stateCount[0] n_b0)
	(mapping "and" h14b n_b0 hit14)
	(mux (hit14) (sc_wrap)
		(1 zero4)
		(- sc_inc)
	)
	(mux (stall) (sc_next)
		(1 stateCount)
		(- sc_wrap)
	)
	(mov 4 stateCount[0] sc_next[0])

	(# 相位判据：取指拍是 0..8 这九个值（多值集合写成一个分支），
	   12/13/14 拍各自单独取出来
	)
	(mux (stateCount) (fetching)
		((0 1 2 3 4 5 6 7 8) const_one)
		(- const_zero)
	)
	(mux (stateCount) (ph12sel)
		(12 const_one)
		(- const_zero)
	)
	(mux (stateCount) (ph13sel)
		(13 const_one)
		(- const_zero)
	)
	(mux (stateCount) (ph14sel)
		(14 const_one)
		(- const_zero)
	)

	(# 程序内存只读，地址一直跟着 pc 走
	)
	(mapping "set" 0 program_we[0])
	(parallel (lt cntIndex 8)
		(mapping "set" 0 program_din[cntIndex])
		(var cntIndex (add cntIndex 1))
	)

	(# pc：取指 9 拍里每拍加 1（先跳再说），不进取指拍就保持
	)
	(parallel (lt hitIndex 10)
		(mapping "set" pc[hitIndex] program_addr[hitIndex])
		(mapping "+" pc[hitIndex] pc_carry[hitIndex] pc_sum[hitIndex] pc_carry[(add hitIndex 1)])
		(var hitIndex (add hitIndex 1))
	)
	(# 停机之后 pc 不再推进
	)
	(mapping "not" halted not_halted)
	(mapping "and" fetching not_halted fetch_en)
	(mapping "set" fetch_en[0] pc_carry[0])
	(mux (fetch_en) (pc_inc)
		(1 pc_sum)
		(- pc)
	)

	(# 跳转：jmp 无条件、jmp_t 看 calcResu != 0；都在第 14 拍提交
	)
	(mux (jmpt_req) (jmp_tgt)
		(1 jmp_t)
		(- jmp)
	)
	(mapping "and" doneEn jmp_req jmp_en_a)
	(mapping "and" doneEn jmpt_req jmpt_en_a)
	(mapping "or" jmp_en_a jmpt_en_a jmp_en)
	(mux (jmp_en) (pc_sel)
		(1 jmp_tgt)
		(- pc_inc)
	)
	(mov 10 pc[0] pc_sel[0])

	(# 读回的一字节按拍分装：第 1 拍给 inst 字节，第 2..5 拍依次给 op1 的 4 个字节，
	   第 6..9 拍依次给 op2 的 4 个字节
	)
	(mux (stateCount) (instn)
		(1 program_dout)
		(- instByte)
	)
	(mov 8 instByte[0] instn[0])
	(mux (stateCount) (op1n0)
		(2 program_dout)
		(- op1B0)
	)
	(mov 8 op1B0[0] op1n0[0])
	(mux (stateCount) (op1n1)
		(3 program_dout)
		(- op1B1)
	)
	(mov 8 op1B1[0] op1n1[0])
	(mux (stateCount) (op1n2)
		(4 program_dout)
		(- op1B2)
	)
	(mov 8 op1B2[0] op1n2[0])
	(mux (stateCount) (op1n3)
		(5 program_dout)
		(- op1B3)
	)
	(mov 8 op1B3[0] op1n3[0])
	(mux (stateCount) (op2n0)
		(6 program_dout)
		(- op2B0)
	)
	(mov 8 op2B0[0] op2n0[0])
	(mux (stateCount) (op2n1)
		(7 program_dout)
		(- op2B1)
	)
	(mov 8 op2B1[0] op2n1[0])
	(mux (stateCount) (op2n2)
		(8 program_dout)
		(- op2B2)
	)
	(mov 8 op2B2[0] op2n2[0])
	(mux (stateCount) (op2n3)
		(9 program_dout)
		(- op2B3)
	)
	(mov 8 op2B3[0] op2n3[0])

	(# 拼装：inst 一字节、op1 四字节、op2 四字节（低字节在前）
	)
	(parallel (lt laneIndex 8)
		(mapping "set" instByte[laneIndex] instWire[laneIndex])
		(mapping "set" op1B0[laneIndex] op1Wire[laneIndex])
		(mapping "set" op1B1[laneIndex] op1Wire[(add laneIndex 8)])
		(mapping "set" op1B2[laneIndex] op1Wire[(add laneIndex 16)])
		(mapping "set" op1B3[laneIndex] op1Wire[(add laneIndex 24)])
		(mapping "set" op2B0[laneIndex] op2Wire[laneIndex])
		(mapping "set" op2B1[laneIndex] op2Wire[(add laneIndex 8)])
		(mapping "set" op2B2[laneIndex] op2Wire[(add laneIndex 16)])
		(mapping "set" op2B3[laneIndex] op2Wire[(add laneIndex 24)])
		(var laneIndex (add laneIndex 1))
	)

	(# 运行内存读出的值：送 op1 地址的下一拍读回的就是 op1Val（第 10 拍收进 r1），
	   送 op2 地址的下一拍读回的就是 op2Val
	)
	(parallel (lt valIndex 32)
		(mapping "set" runtime_dout[valIndex] op1Val[valIndex])
		(mapping "set" runtime_dout[valIndex] op2Val[valIndex])
		(var valIndex (add valIndex 1))
	)

	(# 运行内存地址解析：参数（4 字节）就是变量的字节地址，变量按 32 位对齐，
	   取参数第 2..9 位当 256 字的字地址（低 2 位是字内字节偏移，对齐变量恒为 0）
	)
	(parallel (lt addrIndex 8)
		(mapping "set" op1Wire[(add addrIndex 2)] op1_addr[addrIndex])
		(mapping "set" op2Wire[(add addrIndex 2)] op2_addr[addrIndex])
		(var addrIndex (add addrIndex 1))
	)
	(# push 的写回地址取 op2 的值（同样取第 2..9 位）
	)
	(parallel (lt pushIndex 8)
		(mapping "set" op2[(add pushIndex 2)] push_addr[pushIndex])
		(var pushIndex (add pushIndex 1))
	)

	(# 运行内存地址：第 9 拍送 op1 的地址、第 10 拍送 op2 的地址、第 14 拍送 push 的地址
	)
	(mux (stateCount) (runtime_addr)
		(9 op1_addr)
		(10 op2_addr)
		(14 push_addr)
	)

	(# 运行内存写数据恒为 calcResu（只有 push 那拍会拉写使能）
	)
	(parallel (lt dinIndex 32)
		(mapping "set" calcResu[dinIndex] runtime_din[dinIndex])
		(var dinIndex (add dinIndex 1))
	)

	(# 指令字节切成操作码（高 6 位）与两个标志（末两位）
	)
	(parallel (lt opIdx 6)
		(mapping "set" instWire[(add opIdx 2)] inst_opcode[opIdx])
		(var opIdx (add opIdx 1))
	)
	(mapping "set" instWire[0] f1[0])
	(mapping "set" instWire[1] f2[0])

	(# 第 10 拍先把 op1 的地址取值收进 r1（立即数型用不到 r1）
	)
	(mux (stateCount) (r1_next)
		(10 op1Val)
		(- r1)
	)
	(mov 32 r1[0] r1_next[0])

	(# 第 11 拍同拍装填：inst、op1（地址型取 r1，立即数型取 op1Wire）、
	   op2（地址型取 op2Val，立即数型取 op2Wire）
	)
	(mux (f1) (op1_ld)
		(1 r1)
		(- op1Wire)
	)
	(mux (stateCount) (op1_next)
		(11 op1_ld)
		(- op1)
	)
	(mov 32 op1[0] op1_next[0])
	(mux (f2) (op2_ld)
		(1 op2Val)
		(- op2Wire)
	)
	(mux (stateCount) (op2_next)
		(11 op2_ld)
		(- op2)
	)
	(mov 32 op2[0] op2_next[0])
	(mux (stateCount) (inst_next)
		(11 inst_opcode)
		(- inst)
	)
	(mov 6 inst[0] inst_next[0])

	(# 第 12 拍：多拍指令发启动脉冲，随后第 13 拍等它忙完
	)
	(mapping "set" 1 const_one[0])
	(mapping "set" 0 const_zero[0])
	(mux (inst) (mul_sel)
		(2 const_one)
	)
	(mapping "and" ph12sel mul_sel start_t)
	(mapping "and" start_t m_not_busy m_start)
	(mux (inst) (div_sel)
		(3 const_one)
	)
	(mapping "and" ph12sel div_sel div_start_t)
	(mapping "and" div_start_t div_not_busy div_start)

	(# 第 14 拍：只有 push 指令把 calcResu 压进 op2 指向的运行内存字
	)
	(mux (inst) (push_sel)
		(8 const_one)
	)
	(mapping "and" doneEn push_sel write_en)
	(mapping "set" write_en[0] runtime_we[0])

	(# 停机标志：HLT 那一拍置位，RESUME（或板级外部 resume_pin）清掉，否则保持
	)
	(mapping "and" doneEn halt_req halt_set)
	(mapping "and" doneEn resume_req resume_set_done)
	(mapping "or" resume_set_done resume_pin resume_set)
	(mapping "not" resume_set not_resume_set)
	(mapping "and" not_resume_set halted halt_keep)
	(mapping "or" halt_set halt_keep halt_next)
	(mov 1 halted[0] halt_next[0])
)

(inst LOAD
	(parallel (lt bitIndex 32) 
		(mapping "set" op2[bitIndex] load[bitIndex])
		(var bitIndex (add bitIndex 1))
	)
)

(inst ADD
	(# 并发展开全加器：两级结构，先加进位再加操作数，两级进位相或)
	(parallel (lt bitIndex 32) 

	(# 注意：wire 构成的逻辑电路中不能出现组合逻辑环)

		(mapping "+" add_carry[bitIndex] op1[bitIndex] add_ps[bitIndex] add_c1[(add bitIndex 1)])
		(mapping "+" add_ps[bitIndex] op2[bitIndex] add_sum[bitIndex] add_c2[(add bitIndex 1)])
		(mapping "or" add_c1[(add bitIndex 1)] add_c2[(add bitIndex 1)] add_carry[(add bitIndex 1)])
		(var bitIndex (add bitIndex 1))
	)
)

(inst SUB
	(# 与 ADD 同构，用 "-" 产生借位)
	(parallel (lt bitIndex 32) 
		(mapping "-" op1[bitIndex] sub_borrow[bitIndex] sub_ps[bitIndex] sub_c1[(add bitIndex 1)])
		(mapping "-" sub_ps[bitIndex] op2[bitIndex] sub_diff[bitIndex] sub_c2[(add bitIndex 1)])
		(mapping "or" sub_c1[(add bitIndex 1)] sub_c2[(add bitIndex 1)] sub_borrow[(add bitIndex 1)])
		(var bitIndex (add bitIndex 1))
	)
)

(inst MUL
	(# 迭代移位乘法器：计数器与忙标志用 cntUpd/busyUpd 显式写出，通路按 busy 选通)
	(mapping "set"  busy[0] cnt_carry[0])
	(parallel (lt cntIndex 5)
		(mapping "cntUpd" busy[0] m_start[0] cnt[cntIndex] cnt_carry[cntIndex] cnt_next[cntIndex] cnt_carry[(add cntIndex 1)])
		(var cntIndex (add cntIndex 1))
	)
	(mov 5 cnt[0] cnt_next[0])

	(# 数满 31 结束本轮)
	(parallel (lt hitIndex 5)
		(mapping "not" cnt[hitIndex] cnt_not[hitIndex])
		(mapping "or" cnt_not[hitIndex] cnt_not_acc[hitIndex] cnt_not_acc[(add hitIndex 1)])
		(var hitIndex (add hitIndex 1))
	)
	(mapping "not" cnt_not_acc[5] cnt_hit[0])
	(mapping "busyUpd" busy[0] m_start[0] cnt_hit[0] busy_next[0])
	(mov 1 busy[0] busy_next[0])

	(# 一拍选通：m_add_en/m_keep 与 m_load/m_idle 互斥)
	(mapping "not" busy[0] m_not_busy[0])
	(mapping "not" m_start[0] m_not_start[0])
	(mapping "not" b_reg[0] m_not_b0[0])
	(mapping "and" busy[0] b_reg[0] m_add_en[0])
	(mapping "and" busy[0] m_not_b0[0] m_busy_hold[0])
	(mapping "and" m_not_busy[0] m_start[0] m_load[0])
	(mapping "and" m_not_busy[0] m_not_start[0] m_idle[0])
	(mapping "or" m_busy_hold[0] m_idle[0] m_keep[0])

	(# 移位结果：忙时被乘数左移、乘数右移)
	(parallel (lt srIndex 31)
		(mapping "and" busy[0] a_reg[srIndex] a_shift[(add srIndex 1)])
		(mapping "and" busy[0] b_reg[(add srIndex 1)] b_shift[srIndex])
		(var srIndex (add srIndex 1))
	)

	(# 逐位展开：32 位加法器与三个寄存器的下一状态)
	(parallel (lt bitIndex 32)

		(# 全加器第 bitIndex 位)
		(mapping "+" carry[bitIndex] acc[bitIndex] m_ps[bitIndex] m_c1[(add bitIndex 1)])
		(mapping "+" m_ps[bitIndex] a_reg[bitIndex] sum[bitIndex] m_c2[(add bitIndex 1)])
		(mapping "or" m_c1[(add bitIndex 1)] m_c2[(add bitIndex 1)] carry[(add bitIndex 1)])

		(# 累加器：忙且乘数最低位为 1 时取和，否则保持，装载拍清 0)
		(mapping "and" m_add_en[0] sum[bitIndex] m_acc_add[bitIndex])
		(mapping "and" m_keep[0] acc[bitIndex] m_acc_hold[bitIndex])
		(mapping "or" m_acc_add[bitIndex] m_acc_hold[bitIndex] acc_next[bitIndex])

		(# 被乘数：忙时左移，装载拍取 op1，空闲保持)
		(mapping "and" m_load[0] op1[bitIndex] m_a_load[bitIndex])
		(mapping "and" m_idle[0] a_reg[bitIndex] m_a_hold[bitIndex])
		(mapping "or" m_a_load[bitIndex] m_a_hold[bitIndex] m_a_keep[bitIndex])
		(mapping "or" m_a_keep[bitIndex] a_shift[bitIndex] a_next[bitIndex])

		(# 乘数：忙时右移，装载拍取 op2，空闲保持)
		(mapping "and" m_load[0] op2[bitIndex] m_b_load[bitIndex])
		(mapping "and" m_idle[0] b_reg[bitIndex] m_b_hold[bitIndex])
		(mapping "or" m_b_load[bitIndex] m_b_hold[bitIndex] m_b_keep[bitIndex])
		(mapping "or" m_b_keep[bitIndex] b_shift[bitIndex] b_next[bitIndex])

		(var bitIndex (add bitIndex 1))
	)

	(mov 32 acc[0] acc_next[0])
	(mov 32 a_reg[0] a_next[0])
	(mov 32 b_reg[0] b_next[0])
)

(inst DIV
	(# 迭代移位除法器：计数与忙标志的写法与 MUL 同构)
	(mapping "set"  div_busy[0] div_cnt_carry[0])
	(parallel (lt cntIndex 5)
		(mapping "cntUpd" div_busy[0] div_start[0] div_cnt[cntIndex] div_cnt_carry[cntIndex] div_cnt_next[cntIndex] div_cnt_carry[(add cntIndex 1)])
		(var cntIndex (add cntIndex 1))
	)
	(mov 5 div_cnt[0] div_cnt_next[0])

	(# 数满 31 结束本轮)
	(parallel (lt hitIndex 5)
		(mapping "not" div_cnt[hitIndex] div_cnt_not[hitIndex])
		(mapping "or" div_cnt_not[hitIndex] div_cnt_not_acc[hitIndex] div_cnt_not_acc[(add hitIndex 1)])
		(var hitIndex (add hitIndex 1))
	)
	(mapping "not" div_cnt_not_acc[5] div_cnt_hit[0])
	(mapping "busyUpd" div_busy[0] div_start[0] div_cnt_hit[0] div_busy_next[0])
	(mov 1 div_busy[0] div_busy_next[0])

	(# 一拍选通：div_busy/div_load/div_idle 互斥)
	(mapping "not" div_busy[0] div_not_busy[0])
	(mapping "not" div_start[0] div_not_start[0])
	(mapping "and" div_not_busy[0] div_start[0] div_load[0])
	(mapping "and" div_not_busy[0] div_not_start[0] div_idle[0])
	(mapping "not" div_load[0] div_not_load[0])

	(# 余数左移值与两个移位结果)
	(parallel (lt srIndex 31)
		(mapping "=" div_rem[srIndex] 1 div_rem_in[(add srIndex 1)])
		(mapping "and" div_busy[0] div_dd[srIndex] div_dd_shift[(add srIndex 1)])
		(mapping "and" div_busy[0] div_quo[srIndex] div_quo_shift[(add srIndex 1)])
		(var srIndex (add srIndex 1))
	)
	(mapping "=" div_dd[31] 1 div_rem_in[0])

	(# 32 位减法器：余数左移结果减除数，两级结构，最终借位说明不够减)
	(parallel (lt bitIndex 32)
		(mapping "-" div_rem_in[bitIndex] div_borrow[bitIndex] div_ps[bitIndex] div_b1[(add bitIndex 1)])
		(mapping "-" div_ps[bitIndex] div_dvs[bitIndex] div_diff[bitIndex] div_b2[(add bitIndex 1)])
		(mapping "or" div_b1[(add bitIndex 1)] div_b2[(add bitIndex 1)] div_borrow[(add bitIndex 1)])
		(var bitIndex (add bitIndex 1))
	)
	(mapping "not" div_borrow[32] div_take[0])
	(mapping "not" div_take[0] div_not_take[0])
	(mapping "and" div_busy[0] div_take[0] div_take_en[0])
	(mapping "and" div_busy[0] div_not_take[0] div_skip_en[0])

	(# 本拍商位就是试减结论)
	(mapping "and" div_busy[0] div_take[0] div_quo_shift[0])

	(# 减法器循环把 bitIndex 留在 32 上，先复位再展开逐位循环)
	(var bitIndex 0)

	(# 逐位展开：四个寄存器的下一状态)
	(parallel (lt bitIndex 32)

		(mapping "and" div_take_en[0] div_diff[bitIndex] div_rem_diff[bitIndex])
		(mapping "and" div_skip_en[0] div_rem_in[bitIndex] div_rem_skip[bitIndex])
		(mapping "and" div_idle[0] div_rem[bitIndex] div_rem_hold[bitIndex])
		(mapping "or" div_rem_diff[bitIndex] div_rem_skip[bitIndex] div_rem_or[bitIndex])
		(mapping "or" div_rem_or[bitIndex] div_rem_hold[bitIndex] div_rem_next[bitIndex])

		(mapping "and" div_load[0] op1[bitIndex] div_dd_load[bitIndex])
		(mapping "and" div_idle[0] div_dd[bitIndex] div_dd_hold[bitIndex])
		(mapping "or" div_dd_load[bitIndex] div_dd_hold[bitIndex] div_dd_or[bitIndex])
		(mapping "or" div_dd_or[bitIndex] div_dd_shift[bitIndex] div_dd_next[bitIndex])

		(mapping "and" div_idle[0] div_quo[bitIndex] div_quo_hold[bitIndex])
		(mapping "or" div_quo_shift[bitIndex] div_quo_hold[bitIndex] div_quo_next[bitIndex])

		(mapping "and" div_load[0] op2[bitIndex] div_dvs_load[bitIndex])
		(mapping "and" div_not_load[0] div_dvs[bitIndex] div_dvs_hold[bitIndex])
		(mapping "or" div_dvs_load[bitIndex] div_dvs_hold[bitIndex] div_dvs_next[bitIndex])

		(var bitIndex (add bitIndex 1))
	)

	(mov 32 div_rem[0] div_rem_next[0])
	(mov 32 div_dd[0] div_dd_next[0])
	(mov 32 div_quo[0] div_quo_next[0])
	(mov 32 div_dvs[0] div_dvs_next[0])
)

(inst EQNE
	(# 相等比较：逐位求不等标志并从 0 起或链，末端取反即相等)
	(parallel (lt bitIndex 32)
		(mapping "=" op1[bitIndex] op2[bitIndex] eqBit[bitIndex])
		(mapping "not" eqBit[bitIndex] neBit[bitIndex])
		(mapping "or" neBit[bitIndex] neAcc[bitIndex] neAcc[(add bitIndex 1)])
		(var bitIndex (add bitIndex 1))
	)

	(# 结论写 allCases，并落到 eqRes 供 mux 取用)
	(mapping "not" neAcc[32] eqAny[0])
	(mapping "set"  eqAny[0] allCases[0])
	(mapping "not" eqAny[0] neAny[0])
	(mapping "set"  neAny[0] allCases[1])

	(# 相等时取 1；不等时该分支不成立，没有行命中，eqRes 恒为 0)
	(cases allCases
		0 ((mapping "set"  1 eqRes[0]))
		1 ((mapping "set"  1 neRes[0]))
	)
)

(inst LTGE
	(# 小于比较：自带减法器，取借位链末端)
	(parallel (lt bitIndex 32)
		(mapping "-" op1[bitIndex] lt_borrow[bitIndex] lt_ps[bitIndex] lt_b1[(add bitIndex 1)])
		(mapping "-" lt_ps[bitIndex] op2[bitIndex] lt_diff[bitIndex] lt_b2[(add bitIndex 1)])
		(mapping "or" lt_b1[(add bitIndex 1)] lt_b2[(add bitIndex 1)] lt_borrow[(add bitIndex 1)])
		(var bitIndex (add bitIndex 1))
	)
	(mapping "=" lt_borrow[32] 1 ltFlag[0])
	(mapping "=" lt_borrow[32] 0 geFlag[0])
)

(inst JMP
	(# 无条件跳转：跳转请求 = (inst == 10)，目标就是 op2 的低 10 位（程序字节地址）
	)
	(mux (inst) (jmp_req)
		(10 const_one)
		(- const_zero)
	)
	(parallel (lt jmpIdx 10)
		(mapping "set" op2[jmpIdx] jmp[jmpIdx])
		(var jmpIdx (add jmpIdx 1))
	)
)

(inst JMP_T
	(# 条件跳转：calcResu 整个 32 位不为 0 才算条件成立
	)
	(mapping "set" 0 nzAcc[0])
	(parallel (lt bitIndex 32)
		(mapping "or" calcResu[bitIndex] nzAcc[bitIndex] nzAcc[(add bitIndex 1)])
		(var bitIndex (add bitIndex 1))
	)
	(mapping "set" nzAcc[32] isTrue[0])
	(mux (inst) (jmpt_req)
		(11 isTrue)
		(- const_zero)
	)
	(parallel (lt jmpIdx 10)
		(mapping "set" op2[jmpIdx] jmp_t[jmpIdx])
		(var jmpIdx (add jmpIdx 1))
	)
)

(inst HLT
	(# 只发停机请求；停机状态由 FETCH 里的 halted 寄存器维护
	)
	(mux (inst) (halt_req)
		(12 const_one)
		(- const_zero)
	)
)

(inst RESUME
	(# 只发唤醒请求；板级也可以直接拉 resume_pin
	)
	(mux (inst) (resume_req)
		(13 const_one)
		(- const_zero)
	)
)
